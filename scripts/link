#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

REPLACEMENT="${1:-"../ours-privacy-platform-go"}"
echo "==> Replacing Go SDK with $REPLACEMENT"
if [[ -d "$REPLACEMENT" ]] || go list -m "$REPLACEMENT" >/dev/null; then
    go mod edit -replace github.com/with-ours/platform-sdk-go="$REPLACEMENT"
    go mod tidy -e
else
    echo "Skipping Go SDK replacement (branch may not exist on Go SDK)"
fi
